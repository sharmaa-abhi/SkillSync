# SkillSync AI Environment Template
NEXTAUTH_SECRET="your-32-char-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"
NODE_ENV="development"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_key"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_key"
SUPABASE_SECRET_KEY="sb_secret_key"
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# Supabase PostgreSQL Connection
# Transaction-mode pooler (IPv4 / PgBouncer port 6543)
DATABASE_URL="postgresql://postgres.your-project-ref:encoded_password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30&pool_timeout=30"

# Session-mode pooler (port 5432, used for Prisma migrations)
DIRECT_URL="postgresql://postgres.your-project-ref:encoded_password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?connect_timeout=30"
